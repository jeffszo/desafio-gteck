{
  "name": "gteck-technical-test",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "docker compose exec -T postgres psql -U gteck -d gteck_technical_test -f - < prisma/seed.sql",
